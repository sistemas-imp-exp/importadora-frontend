# URL base del API. Sin esta variable el frontend usa http://127.0.0.1:8000/api/
# (loopback), que es lo correcto al trabajar en la propia máquina.
#
# Apunta a la IP del servidor SOLO cuando pruebes desde otro dispositivo de la
# red: una IP de LAN no salta la resolución de proxy del navegador, así que las
# peticiones pasan a depender del DNS y se degradan si la red va lenta.
# VITE_API_URL=http://192.168.1.21:8000/api/
